<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenMagicka.Content\OpenMagicka.Content.csproj" />
    <ProjectReference Include="..\..\src\OpenMagicka.Engine\OpenMagicka.Engine.csproj" />
    <ProjectReference Include="..\..\src\OpenMagicka.Net\OpenMagicka.Net.csproj" />
    <ProjectReference Include="..\..\src\OpenMagicka.Tools\OpenMagicka.Tools.csproj" />
    <ProjectReference Include="..\..\src\OpenMagicka.Game\OpenMagicka.Game.csproj" />
    <ProjectReference Include="..\..\src\OpenMagicka.Gameplay\OpenMagicka.Gameplay.csproj" />
    <ProjectReference Include="..\..\src\OpenMagicka.Physics\OpenMagicka.Physics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- FAudio (and SDL3, which it runs on) for the sound tests (OM-51); they pass silently without them. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <None Include="$(RootDir)lib/fnalibs/x64/FAudio.dll;$(RootDir)lib/fnalibs/x64/SDL3.dll" Condition="Exists('$(RootDir)lib/fnalibs/x64/FAudio.dll')"
      CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <None Include="$(RootDir)lib/fnalibs/lib64/libFAudio.so.0;$(RootDir)lib/fnalibs/lib64/libSDL3.so.0" Condition="Exists('$(RootDir)lib/fnalibs/lib64/libFAudio.so.0')"
      CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
