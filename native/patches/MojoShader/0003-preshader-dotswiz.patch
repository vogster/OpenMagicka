diff --git a/mojoshader.c b/mojoshader.c
--- a/mojoshader.c
+++ b/mojoshader.c
@@ -2681,10 +2681,27 @@ static void parse_preshader(Context *ctx, const uint32 *tokens, uint32 tokcount)
             case 0xA080: opcode = MOJOSHADER_PRESHADEROP_DIV_SCALAR; break;
             case 0xD000: opcode = MOJOSHADER_PRESHADEROP_DOT_SCALAR; break;
             case 0xD020: opcode = MOJOSHADER_PRESHADEROP_NOISE_SCALAR; break;
+            case 0x70E0: opcode = MOJOSHADER_PRESHADEROP_DOTSWIZ6; break;  // OpenMagicka fork
+            case 0x70D0: opcode = MOJOSHADER_PRESHADEROP_DOTSWIZ8; break;  // OpenMagicka fork
             default: fail(ctx, "Unknown preshader opcode."); break;
         } // switch
 
-        uint32 operand_count = SWAP32(fxlc.tokens[1]) + 1;  // +1 for dest.
+        // OpenMagicka fork: never write past the operand array (the count may also wrap).
+        const uint32 source_count = SWAP32(fxlc.tokens[1]);
+        if (source_count >= STATICARRAYLEN(inst->operands))
+        {
+            fail(ctx, "Too many preshader operands.");
+            return;
+        } // if
+        // OpenMagicka fork: dotswiz is only known for a single result element.
+        if (((opcode == MOJOSHADER_PRESHADEROP_DOTSWIZ6) || (opcode == MOJOSHADER_PRESHADEROP_DOTSWIZ8))
+            && ((opcodetok & 0xFF) != 1))
+        {
+            fail(ctx, "Unsupported preshader dotswiz element count.");
+            return;
+        } // if
+
+        uint32 operand_count = source_count + 1;  // +1 for dest.
 
         inst->opcode = opcode;
         inst->element_count = (unsigned int) (opcodetok & 0xFF);
