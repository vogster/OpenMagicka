-    MOJOSHADER_PRESHADEROP_NOISE_SCALAR
+    MOJOSHADER_PRESHADEROP_NOISE_SCALAR,
+    // OpenMagicka fork: dot products of N scalar sources with N more (N = 3 or 4), one result.
+    MOJOSHADER_PRESHADEROP_DOTSWIZ6,
+    MOJOSHADER_PRESHADEROP_DOTSWIZ8
 } MOJOSHADER_preshaderOpcode;
 
 typedef enum MOJOSHADER_preshaderOperandType
@@ -469,7 +472,7 @@ typedef struct MOJOSHADER_preshaderInstruction
