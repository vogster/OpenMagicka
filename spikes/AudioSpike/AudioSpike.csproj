<Project Sdk="Microsoft.NET.Sdk">

  <!-- Risk check OM-18: do the original XACT banks play on FNA / FAudio? Not part of the game. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <FnaLibs>$(RootDir)lib/fnalibs/</FnaLibs>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(FnaProject)" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <None Include="$(FnaLibs)x64/*.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <None Include="$(FnaLibs)lib64/*" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
