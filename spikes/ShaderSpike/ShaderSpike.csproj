<Project Sdk="Microsoft.NET.Sdk">

  <!-- Risk check OM-20: do the original fx_2_0 effects run on FNA? Not part of the game. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <FnaLibs>$(RootDir)lib/fnalibs/</FnaLibs>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(FnaProject)" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <None Include="$(FnaLibs)x64/*.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(FnaLibs)D3D12/*.dll" Link="D3D12/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <None Include="$(FnaLibs)lib64/*" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
